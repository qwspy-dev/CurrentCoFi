NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001

# Arc is testnet-only. The application deliberately rejects arc-mainnet.
ARC_NETWORK=arc-testnet
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# Add locally after creating a Circle Developer Console test configuration.
CIRCLE_API_KEY=
CIRCLE_APP_ID=

# Never use a production treasury key as a deployer.
ARC_TESTNET_DEPLOYER_PRIVATE_KEY=
CLAIM_AUTHORIZER_ADDRESS=
CLAIM_VAULT_ADDRESS=
