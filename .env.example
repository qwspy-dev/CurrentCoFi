# Production persistence (provision before Group 2)
DATABASE_URL=

# Circle Developer Console credentials (required in Group 2)
CIRCLE_API_KEY=
CIRCLE_APP_ID=
CIRCLE_ENTITY_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
# Keep false until Circle Email OTP has a real SMTP provider configured.
CIRCLE_EMAIL_OTP_ENABLED=false

# Generate separate random values of at least 32 characters
CURRENT_COFI_INTERNAL_SECRET=
CLAIM_SIGNING_SECRET=
CURRENT_CLAIM_AUTHORIZER_PRIVATE_KEY=
CURRENT_CLAIM_VAULT_ADDRESS=
CURRENT_CAMPAIGN_VAULT_ADDRESS=
CURRENT_PROTOCOL_DEPLOYER_PRIVATE_KEY=

# Official Arc Testnet RPC is used by default
ARC_RPC_URL=https://rpc.testnet.arc.network
