# Production persistence (provision before Group 2)
DATABASE_URL=

# Circle Developer Console credentials (required in Group 2)
CIRCLE_API_KEY=
CIRCLE_APP_ID=
CIRCLE_ENTITY_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
# Circle sends and verifies the one-time code; Current never stores a password.
CIRCLE_EMAIL_OTP_ENABLED=false
FACEBOOK_APP_ID=
APPLE_FIREBASE_API_KEY=
APPLE_FIREBASE_AUTH_DOMAIN=
APPLE_FIREBASE_PROJECT_ID=
APPLE_FIREBASE_STORAGE_BUCKET=
APPLE_FIREBASE_MESSAGING_SENDER_ID=
APPLE_FIREBASE_APP_ID=

# Community identities are linked only after Circle wallet authentication.
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=

# Generate separate random values of at least 32 characters
CURRENT_COFI_INTERNAL_SECRET=
CLAIM_SIGNING_SECRET=
CURRENT_CLAIM_AUTHORIZER_PRIVATE_KEY=
CURRENT_CLAIM_VAULT_ADDRESS=
CURRENT_CAMPAIGN_VAULT_ADDRESS=
CURRENT_MILESTONE_ESCROW_ADDRESS=
CURRENT_CHECKOUT_ROUTER_ADDRESS=
CURRENT_TESTNET_CHECKOUT_ADAPTER_ADDRESS=
CURRENT_TOKEN_ADDRESS=
CURRENT_LOCK_VAULT_ADDRESS=
CURRENT_FEE_ROUTER_ADDRESS=
CURRENT_ACCESS_MANAGER_ADDRESS=
CURRENT_BUYBACK_GOVERNOR_ADDRESS=
CURRENT_TESTNET_EXCHANGE_ADAPTER_ADDRESS=
CURRENT_GOVERNANCE_GUARDIAN_ADDRESS=
CURRENT_PROTOCOL_DEPLOYER_PRIVATE_KEY=

